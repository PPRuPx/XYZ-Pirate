  - Key: perk_info_super_throw
    Value: "\u0421\u0443\u043F\u0435\u0440-\u0431\u0440\u043E\u0441\u043E\u043A:
      \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0431\u0440\u043E\u0441\u0430\u0442\u044C
