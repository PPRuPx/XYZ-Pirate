  - Key: perk_info_double_jump
    Value: "\u0414\u0432\u043E\u0439\u043D\u043E\u0439 \u043F\u0440\u044B\u0436\u043E\u043A:
      \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C
